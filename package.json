{
  "name": "siyuan-linker",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Transfer notes and workspace data between local and remote SiYuan instances.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mixyoung/siyuan-linker.git"
  },
  "homepage": "https://github.com/mixyoung/siyuan-linker",
  "author": "steve",
  "license": "MIT",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "validate": "node ./scripts/validate_project.js",
    "build": "pnpm validate && vite build && node ./scripts/validate_package.js",
    "make-install": "pnpm build && node --no-warnings ./scripts/make_install.js"
  },
  "devDependencies": {
    "@types/node": "^20.3.0",
    "adm-zip": "^0.5.16",
    "@vitejs/plugin-vue": "^5.1.3",
    "fast-glob": "^3.2.12",
    "minimist": "^1.2.8",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.63.3",
    "siyuan": "1.2.6",
    "typescript": "^5.1.3",
    "vitest": "^2.1.9",
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^1.0.2",
    "vite-plugin-zip-pack": "^1.0.5",
    "vue-tsc": "^2.1.10"
  },
  "dependencies": {
    "vue": "^3.4.38"
  }
}
